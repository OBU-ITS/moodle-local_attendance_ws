<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/attendance_ws/db" VERSION="20200201" COMMENT="XMLDB file for Moodle local/attendance_ws"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="local_obu_att_session_lookup" COMMENT="Table for storing attendance session ids for lookup">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="slot_id" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="course_id_number" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="session_id" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="local_att_ws_reservations" COMMENT="Stores current state of TimeEdit reservations and Moodle session mapping">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="eventidnumber" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="payloadjson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="payloadhash" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="processedhash" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="session_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="is_processed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="is_delete" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="uniq_eventidnumber" TYPE="unique" FIELDS="eventidnumber"/>
            </KEYS>

            <INDEXES>
                <INDEX NAME="idx_processed" UNIQUE="false" FIELDS="is_processed"/>
                <INDEX NAME="idx_sessionid" UNIQUE="false" FIELDS="session_id"/>
            </INDEXES>
        </TABLE>

    </TABLES>
</XMLDB>
